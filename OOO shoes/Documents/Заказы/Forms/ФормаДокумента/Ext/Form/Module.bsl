&НаКлиенте
Процедура ТоварыИтоговаяЦенаПриИзменении(Элемент)
	ТекСтрока = Элемент.ТекущиеДанные;
  
  Если НЕ ЗначениеЗаполнено(ТекСтрока.Товар) Тогда
    Возврат;
  КонецЕсли;
  
  Товар = ТекСтрока.Товар;
  
  ТекСтрока.Цена = Товар.Цена;
  ТекСтрока.Скидка = Товар.Скидка;
  
  СуммаБезСкидки = ТекСтрока.Количество * ТекСтрока.Цена;
  ТекСтрока.ИтоговаяЦена = СуммаБезСкидки - (СуммаБезСкидки * ТекСтрока.Скидка / 100);
КонецПроцедуры
