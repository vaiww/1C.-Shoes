// В модуле объекта справочника "Товары"

Процедура ПередЗаписью(Отказ)
        Если ЭтотОбъект.Скидка > 0 Тогда
        ЭтотОбъект.ИтоговаяЦена = ЭтотОбъект.Цена * (1 - (ЭтотОбъект.Скидка / 100));
    Иначе
        ЭтотОбъект.ИтоговаяЦена = ЭтотОбъект.Цена;
    КонецЕсли;
КонецПроцедуры
&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Если Склад = Неопределено Тогда
        Склад = Справочники.Склады.ПустаяСсылка();
    КонецЕсли;

    ОбновитьСписок();

КонецПроцедуры
&НаКлиенте
Процедура ОбновитьСписок()

    Товары = ПолучитьТовары(Склад);
    ЭлементыФормы.Список.Загрузить(Товары);

КонецПроцедуры