Перем ТекущийПользователь;


&НаКлиенте
Процедура ПриОткрытии(Отказ, СтандартнаяОбработка)

    Если Параметры.Свойство("Пользователь") Тогда  
        ТекущийПользователь = Параметры.Пользователь;  
    КонецЕсли;

    Если ТекущийПользователь = Неопределено Тогда
        ОткрытьФорму("ОбщаяФорма.ФормаАвторизации");
        Отказ = Истина;
        Возврат;
    КонецЕсли;

    ОбновитьСписок();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок()

    // Получаем товары
    Товары = ПолучитьТовары();

    // Обновляем таблицу
    Элементы.СписокТоваров.Очистить();
    Для Каждого Строка Из Товары Цикл
        Элементы.СписокТоваров.Добавить(Строка);
    КонецЦикла;

КонецПроцедуры
&НаСервере
Процедура ТоварыПриЗаписи(Отказ, СтандартнаяОбработка)

    // Пересчитываем итоговую цену при сохранении товара
    Если ЭтотОбъект.Скидка > 0 Тогда
        ЭтотОбъект.ИтоговаяЦена = ЭтотОбъект.Цена * (1 - (ЭтотОбъект.Скидка / 100));
    Иначе
        ЭтотОбъект.ИтоговаяЦена = ЭтотОбъект.Цена;
    КонецЕсли;

КонецПроцедуры
&НаСервере
Функция ПолучитьТовары()

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Товары.Ссылка КАК Ссылка,
    |   Товары.Наименование КАК Наименование,
    |   Товары.Цена КАК Цена,
    |   ЕСТЬNULL(Товары.Скидка, 0) КАК Скидка,
    |   ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоНаСкладе,
    |   Товары.Цена * (1 - ЕСТЬNULL(Товары.Скидка, 0) / 100) КАК ИтоговаяЦена
    |ИЗ Справочник.Товары КАК Товары
    |ЛЕВОЕ СОЕДИНЕНИЕ
    |   РегистрНакопления.ОстаткиТоваров.Остатки() КАК Остатки
    |ПО Остатки.Товар = Товары.Ссылка";

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции
&НаКлиенте
Процедура ПоискПриИзменении(Элемент)

    Товары = НайтиТовары(Поиск);

КонецПроцедуры



&НаСервере
Функция НайтиТовары(СтрокаПоиска)

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   Товары.Ссылка КАК Ссылка,
    |   Товары.Наименование КАК Наименование,
    |   Товары.Цена КАК Цена,
    |   ЕСТЬNULL(Товары.Скидка, 0) КАК Скидка,
    |   ЕСТЬNULL(Товары.Количество, 0) КАК Количество,
    |   Товары.Цена * (1 - (ЕСТЬNULL(Товары.Скидка, 0) / 100.0)) КАК ИтоговаяЦена
    |ИЗ Справочник.Товары КАК Товары
    |ГДЕ Товары.Наименование ПОДОБНО &Поиск";

    Запрос.УстановитьПараметр("Поиск", "%" + СтрокаПоиска + "%");

    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаКлиенте
Процедура Добавить(Команда)

    ОткрытьФорму("Справочник.Товары.ФормаОбъекта");

КонецПроцедуры


&НаКлиенте
Процедура Удалить(Команда)

    Если Элементы.СписокТоваров.ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Если Вопрос("Удалить товар?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
        УдалитьТовар(Элементы.СписокТоваров.ТекущиеДанные.Ссылка);
        ОбновитьСписок();
    КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура УдалитьТовар(Команда)

    // Проверяем, выбрана ли строка
    Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
        Сообщить("Ошибка: выберите товар для удаления.");
        Возврат;
    КонецЕсли;

    // Подтверждение
    Если Вопрос(
        "Вы уверены, что хотите удалить товар? Это действие нельзя отменить.",
        РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;

    // Получаем ссылку из текущей строки
    СсылкаНаТовар = Элементы.Список.ТекущиеДанные.Ссылка;

    // Получаем объект
    ОбъектТовара = СсылкаНаТовар.ПолучитьОбъект();

    // Удаляем
    ОбъектТовара.Удалить();

    Сообщить("Товар удалён.");

    // Обновляем список
    Элементы.Список.Обновить();

КонецПроцедуры
// В модуле формы

// Обработчик при изменении цены
&НаКлиенте
Процедура СписокТоваровЦенаПриИзменении(Элемент)
    ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
    Если ТекущиеДанные <> Неопределено Тогда
        ПересчитатьИтоговуюЦену(ТекущиеДанные);
        // При необходимости можно сразу записать изменение
        // ЗаписатьИзменениеТовара(ТекущиеДанные.Ссылка, ТекущиеДанные.Цена, ТекущиеДанные.Скидка);
    КонецЕсли;
КонецПроцедуры

// Обработчик при изменении скидки
&НаКлиенте
Процедура СписокТоваровСкидкаПриИзменении(Элемент)
    ТекущиеДанные = Элементы.СписокТоваров.ТекущиеДанные;
    Если ТекущиеДанные <> Неопределено Тогда
        ПересчитатьИтоговуюЦену(ТекущиеДанные);
        // ЗаписатьИзменениеТовара(ТекущиеДанные.Ссылка, ТекущиеДанные.Цена, ТекущиеДанные.Скидка);
    КонецЕсли;
КонецПроцедуры

// Процедура для пересчёта итоговой цены в строке
&НаКлиенте
Процедура ПересчитатьИтоговуюЦену(СтрокаТаблицы)
    Цена = СтрокаТаблицы.Цена;
    Скидка = ?(СтрокаТаблицы.Скидка = Неопределено Или СтрокаТаблицы.Скидка = Null, 0, СтрокаТаблицы.Скидка);
    
    Если Скидка > 0 Тогда
        СтрокаТаблицы.ИтоговаяЦена = Цена * (1 - (Скидка / 100));
    Иначе
        СтрокаТаблицы.ИтоговаяЦена = Цена;
    КонецЕсли;
КонецПроцедуры

// Процедура для записи изменений в базу (серверный вызов)
&НаСервере
Процедура ЗаписатьИзменениеТовара(СсылкаНаТовар, НоваяЦена, НоваяСкидка)
    Если НЕ ЗначениеЗаполнено(СсылкаНаТовар) Тогда
        Возврат;
    КонецЕсли;
    
    ТоварОбъект = СсылкаНаТовар.ПолучитьОбъект();
    ТоварОбъект.Цена = НоваяЦена;
    ТоварОбъект.Скидка = НоваяСкидка;
    
    // Пересчёт итоговой цены (можно использовать логику из процедуры ТоварыПриЗаписи)
    Если ТоварОбъект.Скидка > 0 Тогда
        ТоварОбъект.ИтоговаяЦена = ТоварОбъект.Цена * (1 - (ТоварОбъект.Скидка / 100));
    Иначе
        ТоварОбъект.ИтоговаяЦена = ТоварОбъект.Цена;
    КонецЕсли;
    
    Попытка
        ТоварОбъект.Записать();
    Исключение
        Сообщить("Не удалось записать товар: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры