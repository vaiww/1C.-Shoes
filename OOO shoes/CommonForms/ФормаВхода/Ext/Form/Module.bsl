Процедура Войти(Команда)
	
	Пользователь = Справочники.Пользователи.НайтиПоРеквизиту("Логин", Логин);
	
	Если Пользователь.Пустая() Тогда
		Сообщить("Пользователь не найден!");
		Возврат;
	КонецЕсли;
	
	Если Пользователь.Пароль <> Пароль Тогда
		Сообщить("Неверный пароль!");
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Товары.ФормаСписка");
	
КонецПроцедуры   
Процедура Гость(Команда)
	ОткрытьФорму("Справочник.Товары.ФормаСписка");
КонецПроцедуры